<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cacapie">

        <!-- Perbaikan Nama Path DeveloperProfileActivity -->
        <activity
            android:name=".pertemuan_6.DeveloperProfileActivity"
            android:exported="false" />

        <!-- 1. SplashScreenActivity sekarang menjadi halaman utama (Launcher) -->
        <activity
            android:name=".pertemuan_6.SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. AuthActivity (Halaman Login) -->
        <activity
            android:name=".pertemuan_6.AuthActivity"
            android:exported="false" />

        <!-- Activity Kedua untuk Detail Snack -->
        <activity
            android:name=".pertemuan_3.DetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Pertemuan 5: Detail Jambang (Toolbar, Option Menu, Scroll) -->
        <activity
            android:name=".pertemuan_5.FifthActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Pertemuan 5: WebView -->
        <activity
            android:name=".pertemuan_5.WebViewActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Pertemuan 7: BaseActivity dengan BottomNavigation -->
        <activity
            android:name=".BaseActivity"
            android:exported="false" />

        <!-- Activity Utama -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>