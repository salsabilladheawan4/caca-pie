<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FAF8F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDialogOrderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buat Pesanan Baru"
            android:textColor="#3B2314"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Kode Pesanan"
            android:textColor="#665548"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOrderCode"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="#JB-8250"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="14dp"
            android:textColor="#3B2314"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rincian Item Pesanan"
            android:textColor="#665548"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOrderItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_rounded_input"
            android:gravity="top|start"
            android:hint="Contoh: 1x Cappuccino, 1x Apple Pie"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#3B2314"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tanggal &amp; Waktu"
            android:textColor="#665548"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOrderDate"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="21 Nov 2026 • 12:00 WIB"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="#3B2314"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Harga"
                    android:textColor="#665548"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOrderTotal"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_rounded_input"
                    android:hint="$45.00"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="#3B2314"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textColor="#665548"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerOrderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_rounded_input"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
