<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:fillViewport="true"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="30dp"
        android:paddingVertical="40dp">

        <!-- LOGO KAFE -->
        <androidx.cardview.widget.CardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="36dp"
            app:cardElevation="4dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Logo Jambang Cafe"
                android:padding="10dp"
                android:src="@drawable/ic_logo_jambang" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.1"
            android:text="SPECIALTY COFFEE &amp; ROASTERY"
            android:textColor="#887566"
            android:textSize="10sp" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnBackToLogin"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_arrow_back"
                    android:padding="6dp"
                    android:layout_marginEnd="8dp"
                    app:tint="#3B2314"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textColor="#3B2314"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Join the community and start your coffee journey today."
                android:textColor="#887566"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <!-- FORM FIELDS -->
            <EditText
                android:id="@+id/etNama"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_rounded_input"
                android:elevation="2dp"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:paddingHorizontal="20dp"
                android:textColor="#3B2314"
                android:textColorHint="#A89F95"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_input"
                android:elevation="2dp"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="20dp"
                android:textColor="#3B2314"
                android:textColorHint="#A89F95"
                android:textSize="15sp" />

            <!-- Tanggal Lahir Field Style -->
            <TextView
                android:id="@+id/btnTanggalLahir"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_input"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="Date of Birth"
                android:paddingHorizontal="20dp"
                android:textColor="#3B2314"
                android:textColorHint="#A89F95"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Gender Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:textColor="#887566"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"
                    android:textStyle="bold"/>

                <RadioGroup
                    android:id="@+id/rgJenisKelamin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/rbLakiLaki"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Male"
                        android:textColor="#3B2314"
                        android:textSize="14sp"
                        android:buttonTint="#8B4314"/>
                    <RadioButton
                        android:id="@+id/rbPerempuan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Female"
                        android:textColor="#3B2314"
                        android:textSize="14sp"
                        android:buttonTint="#8B4314"/>
                </RadioGroup>
            </LinearLayout>

            <EditText
                android:id="@+id/etUsernameReg"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_input"
                android:elevation="2dp"
                android:hint="Username"
                android:inputType="text"
                android:paddingHorizontal="20dp"
                android:textColor="#3B2314"
                android:textColorHint="#A89F95"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etPasswordReg"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_input"
                android:elevation="2dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingHorizontal="20dp"
                android:textColor="#3B2314"
                android:textColorHint="#A89F95"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etConfirmPasswordReg"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_input"
                android:elevation="2dp"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:paddingHorizontal="20dp"
                android:textColor="#3B2314"
                android:textColorHint="#A89F95"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnSelanjutnya"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#8B4314"
                android:elevation="4dp"
                android:text="Create Account →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
