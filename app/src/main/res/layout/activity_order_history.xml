<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    tools:context=".pertemuan_10.OrderHistoryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FFFFFF"
            android:elevation="2dp"
            app:navigationIconTint="#3B2314"
            app:titleTextColor="#3B2314" />

        <!-- TabLayout (Modul 11) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="1dp"
            app:tabGravity="fill"
            app:tabIndicatorColor="#8B4314"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabRippleColor="#208B4314"
            app:tabSelectedTextColor="#8B4314"
            app:tabTextColor="#887566" />

        <!-- ViewPager2 untuk Swipe Antar Tab (Modul 11) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- FAB Tambah Pesanan Baru (Create ke Supabase - Modul 12) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddOrder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Tambah Pesanan Baru"
        android:src="@drawable/ic_add"
        app:backgroundTint="#8B4314"
        app:tint="#FFFFFF" />

</FrameLayout>
