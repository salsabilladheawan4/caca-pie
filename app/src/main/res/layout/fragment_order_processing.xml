<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="PESANAN AKTIF / DALAM PROSES"
        android:textColor="#887566"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pbOrdersProcessingLoading"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:indeterminateTint="#8B4314"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyOrdersProcessing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Tidak ada pesanan yang sedang diproses."
        android:textColor="#887566"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ListView dengan CustomAdapter (Modul 10 & Data Supabase Modul 12) -->
    <ListView
        android:id="@+id/lvOrderProcessing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="4dp"
        android:paddingBottom="88dp" />

</LinearLayout>
